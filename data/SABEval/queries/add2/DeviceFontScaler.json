          "apply_to_all_screens": false
        }
      },
      {
        "query": "I'd like to adjust the font size on my smartwatch by a factor of 0.8. Please apply the changes without preview to all screens.",
        "filled_param": {
          "device_type": "smartwatch",
          "scale_factor": 0.8,
          "preview_before_apply": false,
          "apply_to_all_screens": true
        }
      },
      {
        "query": "On my laptop, increase the font size by a factor of 1.2 and preview it before applying to just this screen.",
        "filled_param": {
          "device_type": "laptop",
          "scale_factor": 1.2,
          "preview_before_apply": true,
          "apply_to_all_screens": false
        }
      },
      {
        "query": "Could you scale down the font size on my e-reader by a factor of 0.5, and ensure it applies to all screens with a preview?",
        "filled_param": {
          "device_type": "e-reader",
          "scale_factor": 0.5,
          "preview_before_apply": true,
          "apply_to_all_screens": true
        }
      }
    ]
